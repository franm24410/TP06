@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Mi primer juego</title>

    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: black;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        canvas {
            background-color: black;
            image-rendering: pixelated;
            width: min(1280px, 95vw);
            height: min(960px, 95vh);
            aspect-ratio: 4 / 3;
        }
    </style>

</head>

<body>
    <canvas id="game" width="640" height="480"></canvas>
    <script>
        window.MAP_URL = '@Url.Content("~/Tiles/MAPATERMINADOAHORASI.tmj")';
    </script>
    <script src="~/js/puzzleConfig.js"></script>
    <script src="~/js/MapRender.js"></script>
    <script src="~/js/piConfig.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>