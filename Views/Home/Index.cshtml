@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <style>
        body { background:#111; color:#eee; font-family:monospace; display:flex; align-items:center; justify-content:center; height:100vh; margin:0; }
        .caja { background:#222; padding:30px 40px; border:2px solid #555; border-radius:8px; width:280px; }
        input { width:100%; padding:8px; margin:6px 0; background:#111; color:#eee; border:1px solid #444; border-radius:4px; font-family:monospace; }
        button { width:100%; padding:10px; margin-top:10px; background:#4a4; color:#fff; border:none; border-radius:4px; font-family:monospace; cursor:pointer; }
        .error { color:#f66; font-size:12px; }
        h2 { margin:0 0 12px 0; text-align:center; }
    </style>
</head>
<body>
    <form class="caja" method="post" action="/Home/Login">
        <h2>INICIAR SESIÓN</h2>
        <input type="text" name="usuario" placeholder="Usuario" required />
        <input type="password" name="contrasenia" placeholder="Contraseña" required />
        <button type="submit">ENTRAR</button>
        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }
    </form>
</body>
</html>