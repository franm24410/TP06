@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Mi primer juego</title>

    <style>
        @@font-face {
            font-family: '8bitoperator';
            src: url('/fonts/8bitOperatorPlus8-Regular.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        @@font-face {
            font-family: '8bitoperator';
            src: url('/fonts/8bitOperatorPlus8-Bold.ttf') format('truetype');
            font-weight: bold;
            font-style: normal;
        }
        body {
            margin: 0;
            overflow: hidden;
            background-color: black;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        canvas {
            background-color: black;
            image-rendering: pixelated;
            width: min(1280px, 95vw);
            height: min(960px, 95vh);
            aspect-ratio: 4 / 3;
        }

        #signGui {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.45);
            z-index: 10;
        }

        #signGui.abierto {
            display: flex;
        }

        #signGui .cartel-box {
            background: black;
            border: 4px solid white;
            border-radius: 8px;
            padding: 28px 36px;
            width: 60%;
            max-width: 480px;
            max-height: 70vh;          
            overflow-y: auto;          
            min-width: 0;              
            overflow-wrap: anywhere;   
            word-break: break-word;
            white-space: pre-wrap;
            color: white;
            font-family: '8bitoperator', monospace;
            font-size: 18px;
            line-height: 1.7;
            text-align: center;
            letter-spacing: 1px;
        }
    </style>

</head>

<body>
    <canvas id="game" width="640" height="480"></canvas>
     <div id="signGui">
        <div class="cartel-box" id="signGuiTexto"></div>
    </div>
    <script>
        window.MAPA_INICIAL = "H1";
    </script>
    <script src="~/js/puzzleConfig.js"></script>
    <script src="~/js/MapRender.js"></script>
    <script src="~/js/piConfig.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/cartelesConfig.js"></script>
</body>
</html>