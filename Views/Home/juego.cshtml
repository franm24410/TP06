@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Juego - @ViewBag.Nombre</title>
    <link rel="stylesheet" href="~/css/sansFight.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mundo.css" asp-append-version="true" />
    <style>
        body { margin:0; overflow:hidden; background:#000; height:100vh; display:flex; align-items:center; justify-content:center; }
        canvas { background:#000; image-rendering:pixelated; width:min(1280px,95vw); height:min(960px,95vh); aspect-ratio:4/3; }

        /* GUI genérica centrada */
        .gui { position:fixed; inset:0; display:none; align-items:center; justify-content:center; background:rgba(0,0,0,.45); z-index:10; }
        .gui.abierto { display:flex; }
        .gui .caja { background:#000; border:4px solid #fff; border-radius:8px; padding:24px 32px; max-width:480px; width:60%;
                     color:#fff; font-family:'8bitoperator',monospace; font-size:18px; line-height:1.6; text-align:center; }
        .gui button { margin-top:14px; padding:10px 22px; background:#4a4; color:#fff; border:none; border-radius:4px;
                      font-family:'8bitoperator',monospace; font-size:16px; cursor:pointer; }
        #salir { position:fixed; top:8px; right:12px; z-index:20; }
    </style>
</head>
<body>
    <canvas id="game" width="640" height="480"></canvas>
    <a id="salir" href="/Home/Logout" style="color:#888;font-family:monospace;font-size:12px;">Salir</a>

    <!-- GUI de cartel (C1..C10) -->
    <div id="signGui" class="gui"><div class="caja" id="signGuiTexto"></div></div>

    <!-- GUI de guardado (GUA1) -->
    <div id="saveGui" class="gui">
        <div class="caja">
            <div>¿Querés guardar tu partida?</div>
            <button id="btnGuardar">GUARDAR</button>
            <div id="saveMsg" style="margin-top:8px;font-size:14px;color:#8f8;"></div>
        </div>
    </div>

    <!-- GUI de la pelea contra Sans (PEL1) — ver wwwroot/js/sansFight.js -->
    <div id="sansBattle">
        <canvas id="sbCanvas" width="640" height="480"></canvas>
        <div class="sb-controles">FLECHAS / WASD: mover &nbsp;·&nbsp; Z / ENTER: confirmar &nbsp;·&nbsp; X / SHIFT: volver</div>
    </div>

    <!-- Pelea contra monstruos comunes (encuentros aleatorios) — ver wwwroot/js/enemyFight.js -->
    <div id="enemyBattle">
        <canvas id="ebCanvas" width="640" height="480"></canvas>
        <div class="sb-controles">FLECHAS / WASD: mover &nbsp;·&nbsp; Z / ENTER: confirmar &nbsp;·&nbsp; X / SHIFT: volver</div>
    </div>

    <script>
        window.MAPA_INICIAL = "H1";
        window.NOMBRE_JUGADOR = @Json.Serialize((string)ViewBag.Nombre ?? "");
    </script>
    <script src="~/js/puzzleConfig.js" asp-append-version="true"></script>
    <script src="~/js/piConfig.js" asp-append-version="true"></script>
    <script src="~/js/mapRender.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cartelesConfig.js" asp-append-version="true"></script>
    <script src="~/js/jugador.js" asp-append-version="true"></script>
    <script src="~/js/mundoConfig.js" asp-append-version="true"></script>
    <script src="~/js/mundo.js" asp-append-version="true"></script>
    <script src="~/js/musica.js" asp-append-version="true"></script>
    <script src="~/js/sansAttacks.js" asp-append-version="true"></script>
    <script src="~/js/sansFight.js" asp-append-version="true"></script>
    <script src="~/js/enemyFight.js" asp-append-version="true"></script>
    <script src="~/js/guardias.js" asp-append-version="true"></script>
</body>
</html>