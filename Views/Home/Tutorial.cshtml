@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Tutorial - Subterra</title>
    <link rel="stylesheet" href="~/css/sansFight.css" />
    <style>
        body { margin:0; overflow:hidden; background:#000; height:100vh; display:flex; align-items:center; justify-content:center; }
        canvas { background:#000; image-rendering:pixelated; width:min(1280px,95vw); height:min(960px,95vh); aspect-ratio:4/3; }
        
        .btn-volver {
            position: fixed;
            top: 20px;
            left: 20px;
            padding: 12px 24px;
            background: linear-gradient(135deg, #00d4ff, #7b2ff7);
            color: white;
            border: none;
            border-radius: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            cursor: pointer;
            z-index: 100;
            transition: all 0.3s ease;
        }

        .btn-volver:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 212, 255, 0.4);
        }

        .tutorial-info {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            padding: 12px 24px;
            border-radius: 8px;
            color: #a0a0b8;
            font-size: 13px;
            z-index: 100;
        }

        /* GUI genérica centrada */
        .gui { position:fixed; inset:0; display:none; align-items:center; justify-content:center; background:rgba(0,0,0,.45); z-index:10; }
        .gui.abierto { display:flex; }
        .gui .caja { background:#000; border:4px solid #fff; border-radius:8px; padding:24px 32px; max-width:480px; width:60%;
                     color:#fff; font-family:'8bitoperator',monospace; font-size:18px; line-height:1.6; text-align:center; }
        .gui button { margin-top:14px; padding:10px 22px; background:#4a4; color:#fff; border:none; border-radius:4px;
                      font-family:'8bitoperator',monospace; font-size:16px; cursor:pointer; }
    </style>
</head>
<body>
    <button class="btn-volver" onclick="volverAlMenu()">← VOLVER AL MENÚ</button>
    <canvas id="game" width="640" height="480"></canvas>
    <div class="tutorial-info">Tutorial - Presiona E para interactuar</div>

    <!-- GUI de cartel (necesario para site.js) -->
    <div id="signGui" class="gui"><div class="caja" id="signGuiTexto"></div></div>

    <!-- GUI de guardado (necesario para site.js) -->
    <div id="saveGui" class="gui">
        <div class="caja">
            <div>¿Querés guardar tu partida?</div>
            <button id="btnGuardar">GUARDAR</button>
            <div id="saveMsg" style="margin-top:8px;font-size:14px;color:#8f8;"></div>
        </div>
    </div>

    <!-- ️ IMPORTANTE: estas variables se establecen ANTES de cargar site.js -->
    <script>
        window.MAPA_INICIAL = "H21";
        window.MODO_TUTORIAL = true;
    </script>

    <script src="~/js/puzzleConfig.js"></script>
    <script src="~/js/piConfig.js"></script>
    <script src="~/js/mapRender.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/cartelesConfig.js"></script>

    <!-- Script del tutorial: solo lógica específica, sin redeclarar variables -->
    <script>
        function volverAlMenu() {
            if (confirm('¿Querés volver al menú principal?')) {
                window.location.href = '/Home/Menu';
            }
        }

        // Sobrescribir checkDoors para detectar ph39
        const _originalCheckDoors = window.checkDoors;
        window.checkDoors = function(p) {
            if (_originalCheckDoors) _originalCheckDoors(p);
            
            if (window.habitacionActual && window.habitacionActual.Interactivos) {
                const ph39 = window.habitacionActual.Interactivos.find(i => i.Nombre === 'ph39');
                if (ph39) {
                    const dist = Math.hypot(p.x - ph39.X, p.y - ph39.Y);
                    if (dist < 30) {
                        setTimeout(() => {
                            if (confirm('¿Querés salir del tutorial y volver al menú?')) {
                                window.location.href = '/Home/Menu';
                            }
                        }, 500);
                    }
                }
            }
        };

        // Deshabilitar guardado en tutorial
        if (btnGuardar) {
            btnGuardar.addEventListener('click', () => {
                saveMsg.textContent = "✔ El tutorial no se guarda";
                setTimeout(cerrarSave, 700);
            });
        }
    </script>
</body>
</html>