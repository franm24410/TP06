@{
    Layout = null; // mantiene el mismo estilo que Menu.cshtml
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Créditos</title>
    <link rel="stylesheet" href="~/css/subterra.css" asp-append-version="true" />
    <style>
        body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background: #000; color:#fff; }
        .credits-wrap { text-align:center; width:100%; max-width:900px; padding:40px; box-sizing:border-box; }
        .people { display:flex; gap:40px; align-items:flex-start; justify-content:center; flex-wrap:wrap; }
        .person { display:flex; flex-direction:column; align-items:center; gap:12px; }
        .avatar { width:140px; height:140px; border-radius:50%; object-fit:cover; border:4px solid rgba(255,255,255,0.06); background:#222; }
        .person-name { font-size:1.25rem; color:#ffd600; }
        .back-btn { display:inline-block; margin-top:28px; text-decoration:none; color:#fff; border:1px solid rgba(255,255,255,0.08); padding:8px 16px; border-radius:6px; }
    </style>
</head>
<body>
    <div class="credits-wrap">
        <h1 class="titulo">Créditos</h1>
        <div class="people">
            <div class="person">
                <img class="avatar" src="@(Url.Content("~/images/dante.png"))" alt="Dante Bruschetti" />
                <div class="person-name">Dante Bruschetti</div>
            </div>
            <div class="person">
                <img class="avatar" src="@(Url.Content("~/images/francisco.png"))" alt="Francisco Martinez" />
                <div class="person-name">Francisco Martinez</div>
            </div>
        </div>

        <a class="back-btn" href="/Home/Menu">Volver al menú</a>
    </div>
</body>
</html>
